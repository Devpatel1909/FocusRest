KNOWN_SITES = [
    ("youtube", "youtube.com"), ("github", "github.com"), ("gmail", "mail.google.com"),
    ("whatsapp", "web.whatsapp.com"), ("instagram", "instagram.com"), ("facebook", "facebook.com"),
    ("linkedin", "linkedin.com"), ("reddit", "reddit.com"), ("chatgpt", "chatgpt.com"),
