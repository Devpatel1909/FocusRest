def app_name(exe: str, title: str) -> str:
    if exe == "applicationframehost.exe":      # Store / UWP apps: the title is the app name
        return title or "Windows app"
    if not exe:
        return title.split(" - ")[-1].strip() or "Unknown (admin app)"
    if exe in FRIENDLY:
        return FRIENDLY[exe]
    return exe[:-4].replace("_", " ").title() if exe.endswith(".exe") else exe


def clean_title(title: str) -> str:
    t = re.sub(
        r"\s+[-–—]\s+(?:(?:Personal|Work|School|Guest|Profile \d+|Person \d+)\s+[-–—]\s+)?"
        r"(?:Google Chrome|Microsoft.{0,2}Edge|Mozilla Firefox|Brave|Opera|Vivaldi)\s*$",
        "", title)
    t = re.sub(r"\s+and \d+ more pages?$", "", t)
    return t.strip()


def domain_from(text: str):
    """Turn an address-bar value into a domain; None if it does not look like a URL."""
    text = (text or "").strip()
    if not text or " " in text:
        return None
    low = text.lower()
    if low.startswith(("chrome://", "edge://", "brave://", "about:", "vivaldi://", "opera://")):
        return "Browser pages"
    if "://" not in low:
        low = "http://" + low
    try:
        host = urlparse(low).hostname or ""
    except ValueError:
        return None
    if host.startswith("www."):
        host = host[4:]
    if host == "localhost" or re.fullmatch(r"[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}", host):
        return host
    return None


def site_from_title(title: str) -> str:
    t = clean_title(title)
    low = title.lower()
    for key, site in KNOWN_SITES:
        if key in low:
            return site
    if not t:
        return "New tab / unknown"
    return (t[:45] + "...") if len(t) > 45 else t


def is_private(title: str) -> bool:
    low = title.lower()
    return "incognito" in low or "inprivate" in low or "private browsing" in low


def read_browser_url(hwnd):
    """Read the address bar through Windows UI Automation (needs `pip install uiautomation`)."""
    if auto is None:
        return None
    try:
        win = auto.ControlFromHandle(hwnd)
        for sub in ("Address and search bar", "enter address", "Address bar"):
            edit = win.EditControl(SubName=sub)
            if edit.Exists(0, 0):
                return edit.GetValuePattern().Value
    except Exception:
        return None
    return None


def fmt_dur(seconds: float) -> str:
    s = int(seconds)
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m {sec:02d}s"


def fmt_hms(seconds: float) -> str:
    s = int(seconds)
    return f"{s // 3600:02d}:{(s % 3600) // 60:02d}:{s % 60:02d}"


# --------------------------------------------------------------------------
# Categories (used for the Focus score).  Simple keyword rules - edit freely.
# --------------------------------------------------------------------------
CATEGORIES = ["Work", "Communication", "Entertainment", "Other"]
CAT_RULES_APPS = {
    "Work": ("code", "studio", "pycharm", "idea", "terminal", "powershell", "command prompt", "word", "excel",
             "powerpoint", "outlook", "onenote", "notepad", "reader", "claude", "docker", "postman", "figma",
             "photoshop", "illustrator", "git", "sublime", "notion", "obsidian", "anaconda", "jupyter"),
    "Communication": ("whatsapp", "telegram", "discord", "slack", "teams", "zoom", "skype", "signal"),
    "Entertainment": ("spotify", "vlc", "netflix", "steam", "game", "media player", "prime video", "epic"),
}
CAT_RULES_SITES = {
    "Work": ("github", "gitlab", "stackoverflow", "stackexchange", "claude.ai", "chatgpt", "docs.google",
             "drive.google", "localhost", "notion", "figma", "wikipedia", "w3schools", "geeksforgeeks",
             "leetcode", "coursera", "udemy", "kaggle", "developer.", "docs.", "learn.microsoft", "python.org",
             "npmjs", "medium.com", "atlassian", "jira", "trello"),
    "Communication": ("mail.google", "outlook", "whatsapp", "telegram", "slack", "discord", "teams", "zoom",
                      "linkedin", "calendar.google"),
    "Entertainment": ("youtube", "netflix", "instagram", "facebook", "reddit", "x.com", "twitter", "tiktok",
                      "hotstar", "primevideo", "spotify", "twitch", "9gag", "pinterest", "snapchat"),
}


def categorize(name: str, rules: dict) -> str:
    low = name.lower()
    for cat in ("Work", "Communication", "Entertainment"):
        if any(k in low for k in rules[cat]):
            return cat
    return "Other"


def category_totals(snap: dict) -> dict:
    """Seconds per category. Browser time is split by website, other apps by app name."""
    out = {c: 0.0 for c in CATEGORIES}
    for app, sec in snap["apps"]:
        sites = snap["sites"].get(app)
        if sites:
            tracked = 0.0
            for site, s in sites:
                out[categorize(site, CAT_RULES_SITES)] += s
                tracked += s
            out["Other"] += max(0.0, sec - tracked)
        else:
            out[categorize(app, CAT_RULES_APPS)] += sec
    return out


# --------------------------------------------------------------------------
# Usage tracker (background thread)
# --------------------------------------------------------------------------
def blank_day() -> dict:
    return {"apps": {}, "bsites": {}, "hours": {}, "rests": 0, "longest": 0.0}


class UsageTracker(threading.Thread):
    def __init__(self):
        super().__init__(daemon=True)
        self.lock = threading.Lock()
        self.paused = False
        self.streak = 0.0
        self._halt = threading.Event()
        self._site_cache = (None, 0.0, "")
        self.data = self._load()

    # storage
    def _load(self):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            cutoff = (datetime.date.today() - datetime.timedelta(days=KEEP_DAYS)).isoformat()
            return {d: v for d, v in data.items() if d >= cutoff}
        except Exception:
            return {}

    def save(self):
        try:
            os.makedirs(DATA_DIR, exist_ok=True)
            with self.lock:
                payload = json.dumps(self.data, indent=1, ensure_ascii=False)
            tmp = DATA_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(payload)
            os.replace(tmp, DATA_FILE)
        except Exception:
            pass

    def stop(self):
        self._halt.set()

    # writes (lock must be held by caller of _day)
    def _day(self, day=None):
        day = day or datetime.date.today().isoformat()
        d = self.data.setdefault(day, blank_day())
        for k, v in blank_day().items():
            d.setdefault(k, v)
        return d

    def record(self, app: str, site, seconds: float):
        hour = str(datetime.datetime.now().hour)
        with self.lock:
            d = self._day()
            d["apps"][app] = d["apps"].get(app, 0.0) + seconds
            if site is not None:
                b = d["bsites"].setdefault(app, {})
                b[site] = b.get(site, 0.0) + seconds
            d["hours"][hour] = d["hours"].get(hour, 0.0) + seconds
            self.streak += seconds
            if self.streak > d["longest"]:
                d["longest"] = self.streak

    def add_rest(self):
        with self.lock:
            self._day()["rests"] += 1

    # reads (UI thread)
    def dates(self):
        today = datetime.date.today().isoformat()
        with self.lock:
            ds = set(self.data.keys())
        ds.add(today)
        return sorted(ds, reverse=True)

    def snapshot(self, day: str) -> dict:
        with self.lock:
            d = self.data.get(day) or blank_day()
            apps = dict(d.get("apps", {}))
            sites = {b: dict(s) for b, s in d.get("bsites", {}).items()}
            hours = dict(d.get("hours", {}))
            rests = int(d.get("rests", 0))
            longest = float(d.get("longest", 0.0))
        apps_l = sorted(apps.items(), key=lambda kv: kv[1], reverse=True)
        return {
            "apps": apps_l,
            "sites": {b: sorted(s.items(), key=lambda kv: kv[1], reverse=True) for b, s in sites.items()},
            "hours": [float(hours.get(str(h), 0.0)) for h in range(24)],
            "rests": rests,
            "longest": longest,
            "total": sum(s for _, s in apps_l),
        }

    def series(self, end_day: str, n: int = 7):
        """[(date, total_seconds, rests)] for the n days ending at end_day."""
        end = datetime.date.fromisoformat(end_day)
        out = []
        with self.lock:
            for i in range(n - 1, -1, -1):
                day = (end - datetime.timedelta(days=i)).isoformat()
                d = self.data.get(day) or {}
                out.append((day, sum(d.get("apps", {}).values()), int(d.get("rests", 0))))
        return out

    # sampling
    def _site_for(self, hwnd, title):
        key = (hwnd, title)
        cached_key, ts, site = self._site_cache
        if cached_key == key and time.monotonic() - ts < 15:
            return site
        if is_private(title):
            site = "Private browsing (not recorded)"
        else:
            site = domain_from(read_browser_url(hwnd)) or site_from_title(title)
        self._site_cache = (key, time.monotonic(), site)
        return site

    def _loop(self):
        last = time.monotonic()
        last_save = time.monotonic()
        while not self._halt.wait(1.0):
            now = time.monotonic()
            dt = now - last
            last = now
            if dt > 5:          # PC was asleep / thread stalled: don't credit that gap
                dt = 1.0
            try:
                if self.paused or idle_seconds() >= IDLE_LIMIT_SEC:
                    self.streak = 0.0
                else:
                    fg = get_foreground()
                    if fg:
                        hwnd, exe, title = fg
                        own = exe in ("python.exe", "pythonw.exe") and title.startswith(("FocusRest", "Take a rest"))
                        if exe not in SKIP_EXES and not own:
                            name = app_name(exe, title)
                            site = self._site_for(hwnd, title) if exe in BROWSERS else None
                            self.record(name, site, dt)
            except Exception:
                pass
            if now - last_save >= SAVE_EVERY_SEC:
                self.save()
                last_save = now
        self.save()

    def run(self):
        if auto is not None:
            try:
                with auto.UIAutomationInitializerInThread():
                    self._loop()
                return
            except Exception:
                pass
        self._loop()


# --------------------------------------------------------------------------
# Notifications / sounds
# --------------------------------------------------------------------------
def toast(title: str, message: str) -> None:
    """Show a Windows 11 toast notification (no extra packages needed)."""
    def esc(s):
        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&apos;")

    ps = f"""
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] | Out-Null
[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] | Out-Null
$x = New-Object Windows.Data.Xml.Dom.XmlDocument
$x.LoadXml('<toast scenario="reminder"><visual><binding template="ToastGeneric"><text>{esc(title)}</text><text>{esc(message)}</text></binding></visual></toast>')
$n = [Windows.UI.Notifications.ToastNotification]::new($x)
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('{APP_ID}').Show($n)
"""
    encoded = base64.b64encode(ps.encode("utf-16le")).decode()
    try:
        subprocess.Popen(
            ["powershell", "-NoProfile", "-WindowStyle", "Hidden", "-EncodedCommand", encoded],
            creationflags=0x08000000,  # CREATE_NO_WINDOW
        )
    except Exception:
        pass


def play_alarm() -> None:
    """Loud-ish alarm, played in a background thread."""
    def run():
        if not winsound:
            return
        for _ in range(4):
            for freq in (880, 1175, 880, 1175):
                winsound.Beep(freq, 250)
            time.sleep(0.3)
    threading.Thread(target=run, daemon=True).start()


def short_beep() -> None:
    if winsound:
        threading.Thread(target=lambda: winsound.Beep(700, 300), daemon=True).start()


# --------------------------------------------------------------------------
# UI toolkit: theme, scaling, custom-drawn widgets
# --------------------------------------------------------------------------
BG = "#0b1220"
SIDE = "#0f172a"
CARD = "#131c31"
CARD2 = "#1b2744"
BORDER = "#25314d"
GRID = "#1f2a45"
TEXT = "#e5e9f5"
MUTED = "#8b97b3"
ACCENT = "#6366f1"
ACCENT_HI = "#22d3ee"
GOOD = "#34d399"
WARN = "#fbbf24"
BAD = "#f87171"
PALETTE = ["#6366f1", "#22d3ee", "#34d399", "#fbbf24", "#f472b6", "#fb923c"]
CAT_COLORS = {"Work": "#34d399", "Communication": "#22d3ee", "Entertainment": "#f472b6", "Other": "#64748b"}
FONT = "Segoe UI"
SC = 1.0


def S(v) -> int:
    """Scale a pixel size for the current display DPI."""
    return int(round(v * SC))


def f(size, bold=False):
    return (FONT, size, "bold") if bold else (FONT, size)


def rrect(c, x1, y1, x2, y2, r, **kw):
    r = max(0, min(r, (x2 - x1) / 2, (y2 - y1) / 2))
    pts = [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2,
           x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]
    return c.create_polygon(pts, smooth=True, **kw)


def setup_style(root):
    st = ttk.Style(root)
    try:
        st.theme_use("clam")
    except tk.TclError:
        pass
    root.configure(bg=BG)
    root.option_add("*TCombobox*Listbox.background", CARD2)
    root.option_add("*TCombobox*Listbox.foreground", TEXT)
    root.option_add("*TCombobox*Listbox.selectBackground", ACCENT)
    root.option_add("*TCombobox*Listbox.selectForeground", "white")
    root.option_add("*TCombobox*Listbox.font", f(10))
    st.configure(".", font=f(10), background=BG, foreground=TEXT)
    st.configure("TFrame", background=BG)
    st.configure("TCombobox", fieldbackground=CARD2, background=CARD2, foreground=TEXT, arrowcolor=MUTED,
                 bordercolor=BORDER, lightcolor=CARD2, darkcolor=CARD2, padding=(S(8), S(5)))
    st.map("TCombobox", fieldbackground=[("readonly", CARD2)], foreground=[("readonly", TEXT)],
           selectbackground=[("readonly", CARD2)], selectforeground=[("readonly", TEXT)],
           background=[("active", BORDER)])
    st.configure("TSpinbox", fieldbackground=CARD2, background=CARD2, foreground=TEXT, arrowcolor=MUTED,
                 bordercolor=BORDER, lightcolor=CARD2, darkcolor=CARD2, insertcolor=TEXT, padding=(S(6), S(4)))
    st.configure("Treeview", font=f(10), rowheight=S(34), background=CARD, fieldbackground=CARD,
                 foreground=TEXT, borderwidth=0, bordercolor=CARD, lightcolor=CARD, darkcolor=CARD)
    st.configure("Treeview.Heading", font=f(9, True), background=CARD2, foreground=MUTED, relief="flat",
                 padding=(S(8), S(8)), borderwidth=0)
    st.map("Treeview", background=[("selected", "#27325a")], foreground=[("selected", TEXT)])
    st.map("Treeview.Heading", background=[("active", CARD2)])
    st.configure("Vertical.TScrollbar", troughcolor=CARD, background=BORDER, arrowcolor=MUTED,
                 bordercolor=CARD, lightcolor=BORDER, darkcolor=BORDER, relief="flat", arrowsize=S(12))
    st.map("Vertical.TScrollbar", background=[("active", "#34446b")])
    st.configure("Accent.TButton", background=ACCENT, foreground="white", borderwidth=0, focusthickness=0,
                 font=f(10, True), padding=(S(20), S(10)))
    st.map("Accent.TButton", background=[("active", "#4f46e5"), ("pressed", "#4338ca")])
    st.configure("Ghost.TButton", background=CARD2, foreground=TEXT, borderwidth=0, focusthickness=0,
                 font=f(10, True), padding=(S(16), S(9)))
    st.map("Ghost.TButton", background=[("active", BORDER), ("pressed", BORDER)])


class Chart(tk.Canvas):
    """Canvas that redraws itself when resized or given new data."""

    def __init__(self, parent, height=220, bg=CARD):
        super().__init__(parent, bg=bg, highlightthickness=0, height=S(height), width=S(200))
        self.data = None
        self.empty_text = "No data yet"
        self.bind("<Configure>", lambda e: self.redraw())

    def set(self, *data):
        self.data = data
        self.redraw()

    def has_data(self) -> bool:
        return self.data is not None

    def redraw(self):
        self.delete("all")
        w, h = self.winfo_width(), self.winfo_height()
        if w < 30 or h < 30:
            return
        if not self.has_data():
            self.create_text(w / 2, h / 2, text=self.empty_text, fill=MUTED, font=f(10))
            return
        self.paint(w, h)

    def paint(self, w, h):
        raise NotImplementedError


class BarChart(Chart):
    """Vertical bars with grid, axis labels and hover tooltips."""

    def has_data(self):
        return self.data is not None and any(v > 0 for v in self.data[1])

    def paint(self, w, h):
        labels, values, ymax, yticks, hl, tips = self.data
        L, R, T, B = S(44), S(10), S(12), S(26)
        pw, ph = w - L - R, h - T - B
        for v, lab in yticks:
            y = T + ph - ph * v / ymax
            self.create_line(L, y, w - R, y, fill=GRID)
            self.create_text(L - S(8), y, text=lab, anchor="e", fill=MUTED, font=f(8))
        n = len(values)
        slot = pw / n
        bw = min(slot * 0.62, S(38))
        self._geo = (L, slot, n, T, ph)
        self._tips = tips
        self._tops = []
        for i, v in enumerate(values):
            x0 = L + slot * i + (slot - bw) / 2
            bh = max(S(3), ph * min(v, ymax) / ymax) if v > 0 else S(3)
            y0 = T + ph - bh
            color = (ACCENT_HI if i == hl else ACCENT) if v > 0 else CARD2
            rrect(self, x0, y0, x0 + bw, T + ph, S(5), fill=color, outline="")
            self._tops.append(y0)
            if labels[i]:
                self.create_text(L + slot * i + slot / 2, h - B + S(14), text=labels[i], fill=MUTED, font=f(8))
        self.bind("<Motion>", self._move)
        self.bind("<Leave>", lambda e: self.delete("tip"))

    def _move(self, e):
        self.delete("tip")
        if not self.data:
            return
        L, slot, n, T, ph = self._geo
        i = int((e.x - L) // slot)
        if not 0 <= i < n or not self._tips[i]:
            return
        x = L + slot * i + slot / 2
        y = max(self._tops[i] - S(8), T + S(30))
        t = self.create_text(x, y, text=self._tips[i], fill=TEXT, font=f(9), justify="center", tags="tip")
        x0, y0, x1, y1 = self.bbox(t)
        w = self.winfo_width()
        shift = 0
        if x0 - S(8) < 0:
            shift = S(8) - x0
        elif x1 + S(8) > w:
            shift = w - S(8) - x1
        if shift:
            self.move(t, shift, 0)
            x0 += shift
            x1 += shift
        bg = rrect(self, x0 - S(8), y0 - S(5), x1 + S(8), y1 + S(5), S(6), fill="#2a3862", outline=BORDER, tags="tip")
        self.tag_lower(bg, t)


class DonutChart(Chart):
    def has_data(self):
        return self.data is not None and sum(v for _, v, _ in self.data[0]) > 0

    def paint(self, w, h):
        items, main, sub = self.data
        total = sum(v for _, v, _ in items)
        legend = w > S(340)
        d = min(h - S(24), w * 0.44 if legend else w - S(24))
        cx = d / 2 + S(14) if legend else w / 2
        cy = h / 2
        thick = max(S(14), d * 0.13)
        r = d / 2 - thick / 2
        box = (cx - r, cy - r, cx + r, cy + r)
        self.create_oval(*box, outline=CARD2, width=thick)
        cum = 0.0
        gap = 1.6 if len(items) > 1 else 0.0
        for _, v, color in items:
            ext = v / total * 360
            self.create_arc(*box, start=90 - cum - ext + gap / 2, extent=min(359.9, max(0.6, ext - gap)),
                            style="arc", outline=color, width=thick)
            cum += ext
        self.create_text(cx, cy - S(8), text=main, fill=TEXT, font=f(15, True))
        self.create_text(cx, cy + S(14), text=sub, fill=MUTED, font=f(9))
        if not legend:
            return
        x0 = cx + d / 2 + S(30)
        rowh = max(S(26), min(S(38), (h - S(8)) / min(len(items), 6)))
        shown = items[:max(1, int((h - S(8)) // rowh))]
        two_line = rowh >= S(34)
        y = cy - len(shown) * rowh / 2 + rowh / 2
        maxc = max(8, int((w - x0 - S(24) - (0 if two_line else S(80))) / S(7)))
        for label, v, color in shown:
            name = label if len(label) <= maxc else label[:maxc - 1] + "…"
            if two_line:
                self.create_oval(x0, y - S(14), x0 + S(10), y - S(4), fill=color, outline="")
                self.create_text(x0 + S(18), y - S(9), text=name, anchor="w", fill=TEXT, font=f(10))
                self.create_text(x0 + S(18), y + S(8), text=f"{fmt_dur(v)}  ·  {v * 100 / total:.0f}%",
                                 anchor="w", fill=MUTED, font=f(9))
            else:
                self.create_oval(x0, y - S(5), x0 + S(10), y + S(5), fill=color, outline="")
                self.create_text(x0 + S(18), y, text=name, anchor="w", fill=TEXT, font=f(10))
                self.create_text(w - S(12), y, text=fmt_dur(v), anchor="e", fill=MUTED, font=f(9))
            y += rowh


class HBarList(Chart):
    """Ranked list: label + value on one line, a progress bar below."""

    def has_data(self):
        return bool(self.data and self.data[0])

    def paint(self, w, h):
        rows = self.data[0]
        rowh = max(S(34), min(S(44), (h - S(4)) / max(1, min(len(rows), 6))))
        fit = max(1, int((h - S(4)) // rowh))
        pad = S(10)
        y = S(4)
        for label, right, frac, color in rows[:fit]:
            maxc = max(8, int((w - S(150)) / S(7)))
            name = label if len(label) <= maxc else label[:maxc - 1] + "…"
            self.create_text(pad, y + S(8), text=name, anchor="w", fill=TEXT, font=f(10))
            self.create_text(w - pad, y + S(8), text=right, anchor="e", fill=MUTED, font=f(9))
            by = y + S(21)
            rrect(self, pad, by, w - pad, by + S(7), S(3), fill=CARD2, outline="")
            bw = max(S(7), (w - 2 * pad) * max(0.0, min(1.0, frac)))
            rrect(self, pad, by, pad + bw, by + S(7), S(3), fill=color, outline="")
            y += rowh


class Ring(Chart):
    """Circular progress ring with centre text."""

    def __init__(self, parent, size=200, bg=CARD, thick=0.10, main_size=28, sub_size=10):
        super().__init__(parent, height=size, bg=bg)
        self.configure(width=S(size))
        self.thick, self.main_size, self.sub_size = thick, main_size, sub_size

    def has_data(self):
        return self.data is not None

    def paint(self, w, h):
        frac, main, sub, color = self.data
        d = min(w, h) - S(8)
        thick = max(S(6), d * self.thick)
        cx, cy, r = w / 2, h / 2, d / 2 - thick / 2
        box = (cx - r, cy - r, cx + r, cy + r)
        self.create_oval(*box, outline=CARD2, width=thick)
        frac = max(0.0, min(1.0, frac))
        if frac > 0.002:
            self.create_arc(*box, start=90, extent=-min(359.9, frac * 360), style="arc", outline=color, width=thick)
        if main:
            self.create_text(cx, cy - (S(self.sub_size) if sub else 0), text=main, fill=TEXT,
                             font=f(self.main_size, True))
        if sub:
            self.create_text(cx, cy + S(self.main_size) * 0.75, text=sub, fill=MUTED, font=f(self.sub_size))


class Toggle(tk.Canvas):
    def __init__(self, parent, var, command=None, bg=SIDE):
        super().__init__(parent, width=S(44), height=S(24), bg=bg, highlightthickness=0, cursor="hand2")
        self.var, self.command = var, command
        self.bind("<Button-1>", self._flip)
        var.trace_add("write", lambda *a: self._draw())
        self._draw()

    def _flip(self, e=None):
        self.var.set(not self.var.get())
        if self.command:
            self.command()

    def _draw(self):
        self.delete("all")
        w, h = S(44), S(24)
        on = self.var.get()
        col = ACCENT if on else "#334266"
        self.create_oval(0, 0, h, h, fill=col, outline="")
        self.create_oval(w - h, 0, w, h, fill=col, outline="")
        self.create_rectangle(h / 2, 0, w - h / 2, h, fill=col, outline="")
        k = h - S(8)
        x = w - S(4) - k if on else S(4)
        self.create_oval(x, S(4), x + k, S(4) + k, fill="white", outline="")


class NavItem(tk.Frame):
    def __init__(self, parent, text, icon, command):
        super().__init__(parent, bg=SIDE, cursor="hand2")
        self.active = False
        self.bar = tk.Frame(self, bg=SIDE, width=S(4))
        self.bar.pack(side="left", fill="y")
        self.lbl = tk.Label(self, text=f"{icon}   {text}", bg=SIDE, fg=MUTED, font=f(11, True), anchor="w",
                            padx=S(16), pady=S(11))
        self.lbl.pack(side="left", fill="x", expand=True)
        for wdg in (self, self.lbl, self.bar):
            wdg.bind("<Button-1>", lambda e: command())
            wdg.bind("<Enter>", lambda e: self._paint(True))
            wdg.bind("<Leave>", lambda e: self._paint(False))

    def _paint(self, hover=False):
        bg = "#17213b" if (self.active or hover) else SIDE
        self.configure(bg=bg)
        self.lbl.configure(bg=bg, fg=TEXT if self.active else (TEXT if hover else MUTED))
        self.bar.configure(bg=ACCENT if self.active else bg)

    def set_active(self, on):
        self.active = on
        self._paint()


def card(parent, title, right=""):
    outer = tk.Frame(parent, bg=CARD, highlightbackground=BORDER, highlightthickness=1)
    head = tk.Frame(outer, bg=CARD)
    head.pack(fill="x", padx=S(16), pady=(S(14), 0))
    tk.Label(head, text=title, bg=CARD, fg=TEXT, font=f(11, True)).pack(side="left")
    rl = tk.Label(head, text=right, bg=CARD, fg=MUTED, font=f(9))
    rl.pack(side="right")
    body = tk.Frame(outer, bg=CARD)
    body.pack(fill="both", expand=True, padx=S(8), pady=(S(6), S(10)))
    return outer, body, rl


class KPI(tk.Frame):
    def __init__(self, parent, title, accent, ring=False):
        super().__init__(parent, bg=CARD, highlightbackground=BORDER, highlightthickness=1)
        tk.Frame(self, bg=accent, height=S(3)).pack(fill="x")
        inner = tk.Frame(self, bg=CARD)
        inner.pack(fill="both", expand=True, padx=S(16), pady=(S(12), S(14)))
        self.ring = None
        if ring:
            self.ring = Ring(inner, size=64, thick=0.16, main_size=1, sub_size=1)
            self.ring.configure(width=S(64))
            self.ring.pack(side="right")
        col = tk.Frame(inner, bg=CARD)
        col.pack(side="left", fill="both", expand=True)
        tk.Label(col, text=title.upper(), bg=CARD, fg=MUTED, font=f(8, True), anchor="w").pack(fill="x")
        self.value = tk.Label(col, text="-", bg=CARD, fg=TEXT, font=f(24, True), anchor="w")
        self.value.pack(fill="x", pady=(S(4), 0))
        self.sub = tk.Label(col, text="", bg=CARD, fg=MUTED, font=f(9), anchor="w")
        self.sub.pack(fill="x")

    def set(self, value, sub, color=MUTED):
        self.value.config(text=value)
        self.sub.config(text=sub, fg=color)


class NavLabel(tk.Label):
    pass


# --------------------------------------------------------------------------
# Table pages (Apps / Websites)
# --------------------------------------------------------------------------
class TablePage(tk.Frame):
    def __init__(self, parent, columns, first_heading, headings, widths):
        super().__init__(parent, bg=BG)
        self.filter_var = tk.StringVar()
        self.bar_row = tk.Frame(self, bg=BG)
        self.bar_row.pack(fill="x", pady=(0, S(10)))
        self.total = tk.Label(self.bar_row, text="", bg=BG, fg=MUTED, font=f(10))
        self.total.pack(side="right")
        tk.Label(self.bar_row, text="Filter", bg=BG, fg=MUTED, font=f(10)).pack(side="left")
        ent = tk.Entry(self.bar_row, textvariable=self.filter_var, bg=CARD2, fg=TEXT, insertbackground=TEXT,
                       relief="flat", highlightthickness=1, highlightbackground=BORDER, highlightcolor=ACCENT,
                       font=f(10), width=26)
        ent.pack(side="left", padx=S(10), ipady=S(5))
        self.extra = tk.Frame(self.bar_row, bg=BG)
        self.extra.pack(side="left", padx=S(10))

        outer = tk.Frame(self, bg=CARD, highlightbackground=BORDER, highlightthickness=1)
        outer.pack(fill="both", expand=True)
        self.tree = ttk.Treeview(outer, columns=columns, show="tree headings", selectmode="browse")
        self.tree.heading("#0", text=first_heading, anchor="w")
        self.tree.column("#0", width=widths[0], minwidth=S(160), anchor="w", stretch=True)
        for col, text, w in zip(columns, headings, widths[1:]):
            self.tree.heading(col, text=text, anchor="w")
            self.tree.column(col, width=S(w), minwidth=S(50), anchor="w", stretch=(col == "bar"))
        sb = ttk.Scrollbar(outer, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        self.tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        self.tree.tag_configure("odd", background="#161f37")
        self.tree.tag_configure("child", foreground=MUTED)
        self.tree.tag_configure("bar", foreground=ACCENT)

    @property
    def needle(self):
        return self.filter_var.get().strip().lower()


class AppsPage(TablePage):
    def __init__(self, parent):
        super().__init__(parent, ("time", "pct", "bar"), "Application   (browsers expand to websites)",
                         ("Time", "Share", "Usage"), (S(300), 90, 70, 200))

    def refresh(self, snap):
        apps, sites, total = snap["apps"], snap["sites"], snap["total"]
        y = self.tree.yview()[0]
        opened = {self.tree.item(i, "text"): self.tree.item(i, "open") for i in self.tree.get_children()}
        self.tree.delete(*self.tree.get_children())
        needle, shown, n = self.needle, 0, 0
        for name, sec in apps:
            kids = sites.get(name, [])
            self_match = not needle or needle in name.lower()
            kid_rows = [(s, v) for s, v in kids if self_match or needle in s.lower()]
            if not self_match and not kid_rows:
                continue
            frac = sec / total if total else 0
            iid = self.tree.insert("", "end", text=name, open=opened.get(name, True),
                                   values=(fmt_dur(sec), f"{frac * 100:.0f}%", bar(frac)),
                                   tags=("odd",) if n % 2 else ())
            n += 1
            shown += 1
            for site, ssec in kid_rows:
                sf = ssec / sec if sec else 0
                self.tree.insert(iid, "end", text=site, tags=("child",),
                                 values=(fmt_dur(ssec), f"{sf * 100:.0f}%", bar(sf)))
        self.tree.yview_moveto(y)
        self.total.config(text=f"{shown} applications   ·   Total {fmt_dur(total)}")


class SitesPage(TablePage):
    ALL = "All browsers"

    def __init__(self, parent):
        super().__init__(parent, ("browser", "time", "pct", "bar"), "Website",
                         ("Browser", "Time", "Share", "Usage"), (S(280), 130, 90, 70, 180))
        tk.Label(self.extra, text="Browser", bg=BG, fg=MUTED, font=f(10)).pack(side="left")
        self.browser_var = tk.StringVar(value=self.ALL)
        self.combo = ttk.Combobox(self.extra, textvariable=self.browser_var, width=16, state="readonly",
                                  values=[self.ALL])
        self.combo.pack(side="left", padx=S(8))
        self.combo.bind("<<ComboboxSelected>>", lambda e: self.on_pick())
        self.on_pick = lambda: None

    def refresh(self, snap):
        sites = snap["sites"]
        names = [self.ALL] + sorted(sites)
        if tuple(self.combo["values"]) != tuple(names):
            self.combo["values"] = names
        if self.browser_var.get() not in names:
            self.browser_var.set(self.ALL)
        sel = self.browser_var.get()
        agg = {}
        for browser, lst in sites.items():
            if sel != self.ALL and browser != sel:
                continue
            for site, sec in lst:
                e = agg.setdefault(site, [0.0, set()])
                e[0] += sec
                e[1].add(browser)
        needle = self.needle
        rows = sorted(((s, v) for s, v in agg.items() if not needle or needle in s.lower()),
                      key=lambda kv: kv[1][0], reverse=True)
        total = sum(v[0] for _, v in agg.items())
        y = self.tree.yview()[0]
        self.tree.delete(*self.tree.get_children())
        for n, (site, (sec, browsers)) in enumerate(rows):
            frac = sec / total if total else 0
            self.tree.insert("", "end", text=site, tags=("odd",) if n % 2 else (),
                             values=(", ".join(sorted(browsers)), fmt_dur(sec), f"{frac * 100:.0f}%", bar(frac)))
        self.tree.yview_moveto(y)
        self.total.config(text=f"{len(rows)} websites   ·   Total {fmt_dur(total)}")


def bar(frac: float, width: int = 18) -> str:
    return "█" * max(1, int(round(frac * width))) if frac > 0 else ""


def nice_max(v: float, steps) -> float:
    for s in steps:
        if v <= s:
            return s
    return steps[-1]


# --------------------------------------------------------------------------
# Main application
# --------------------------------------------------------------------------
class App:
    PAGES = [("dashboard", "Dashboard", "▣"), ("apps", "Apps", "◫"), ("sites", "Websites", "◍"),
             ("timer", "Rest Timer", "◔")]

    def __init__(self, root: tk.Tk, tracker: UsageTracker):
        global SC
        self.root = root
        self.tracker = tracker
        try:
            SC = max(1.0, root.winfo_fpixels("1i") / 96.0)
        except tk.TclError:
            SC = 1.0
        setup_style(root)
        root.title("FocusRest")
        sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
        root.geometry(f"{min(S(1220), sw - S(60))}x{min(S(800), sh - S(110))}+{S(30)}+{S(20)}")
        root.minsize(min(S(1000), sw - S(60)), min(S(640), sh - S(110)))

        self.state = "work"        # work | rest
        self.paused = False
        self.deadline = 0.0
        self.phase_total = 1.0
        self.paused_remaining = 0.0
        self.break_win = None
        self.break_ring = None
        self.page = "dashboard"
        self._today = datetime.date.today().isoformat()
        self.date_var = tk.StringVar(value=self._today)
        self.interval_var = tk.IntVar(value=DEFAULT_INTERVAL_MIN)
        self.rest_var = tk.IntVar(value=DEFAULT_REST_SEC)
        self.track_var = tk.BooleanVar(value=True)
        self.beep_var = tk.BooleanVar(value=False)   # beep sound: OFF by default

        root.columnconfigure(1, weight=1)
        root.rowconfigure(0, weight=1)
        self._build_sidebar()
        main = tk.Frame(root, bg=BG)
        main.grid(row=0, column=1, sticky="nsew", padx=S(24), pady=S(18))
        main.columnconfigure(0, weight=1)
        main.rowconfigure(1, weight=1)
        self._build_topbar(main)
        host = tk.Frame(main, bg=BG)
        host.grid(row=1, column=0, sticky="nsew", pady=(S(14), 0))
        host.columnconfigure(0, weight=1)
        host.rowconfigure(0, weight=1)
        self.pages = {}
        for key, _, _ in self.PAGES:
            fr = tk.Frame(host, bg=BG)
            fr.grid(row=0, column=0, sticky="nsew")
            self.pages[key] = fr
        self._build_dashboard(self.pages["dashboard"])
        self.apps_page = AppsPage(self.pages["apps"])
        self.apps_page.pack(fill="both", expand=True)
        self.sites_page = SitesPage(self.pages["sites"])
        self.sites_page.pack(fill="both", expand=True)
        self.sites_page.on_pick = self.refresh_now
        for tp in (self.apps_page, self.sites_page):
            tp.filter_var.trace_add("write", lambda *a: self.refresh_now())
        self._build_timer(self.pages["timer"])

        root.protocol("WM_DELETE_WINDOW", self.on_close)
        self.reset()
        self.show("dashboard")
        self.tick()
        self.refresh_loop()

    # ------------------------------------------------------------------ layout
    def _build_sidebar(self):
        side = tk.Frame(self.root, bg=SIDE, width=S(236))
        side.grid(row=0, column=0, sticky="ns")
        side.grid_propagate(False)
        side.pack_propagate(False)
        logo = tk.Frame(side, bg=SIDE)
        logo.pack(fill="x", padx=S(20), pady=(S(26), S(26)))
        cv = tk.Canvas(logo, width=S(38), height=S(38), bg=SIDE, highlightthickness=0)
        cv.pack(side="left")
        rrect(cv, 0, 0, S(38), S(38), S(11), fill=ACCENT, outline="")
        cv.create_oval(S(10), S(10), S(28), S(28), outline="white", width=S(3))
        cv.create_oval(S(16), S(16), S(22), S(22), fill="white", outline="")
        t = tk.Frame(logo, bg=SIDE)
        t.pack(side="left", padx=S(12))
        tk.Label(t, text="FocusRest", bg=SIDE, fg=TEXT, font=f(14, True)).pack(anchor="w")
        tk.Label(t, text="Rest & usage insights", bg=SIDE, fg=MUTED, font=f(8)).pack(anchor="w")

        self.nav = {}
        for key, text, icon in self.PAGES:
            it = NavItem(side, text, icon, lambda k=key: self.show(k))
            it.pack(fill="x", pady=1)
            self.nav[key] = it

        bottom = tk.Frame(side, bg=SIDE)
        bottom.pack(side="bottom", fill="x", padx=S(18), pady=S(20))
        box = tk.Frame(bottom, bg=CARD, highlightbackground=BORDER, highlightthickness=1)
        box.pack(fill="x")
        inner = tk.Frame(box, bg=CARD)
        inner.pack(fill="x", padx=S(14), pady=S(12))
        self.mini_caption = tk.Label(inner, text="NEXT REST IN", bg=CARD, fg=MUTED, font=f(8, True), anchor="w")
        self.mini_caption.pack(fill="x")
        self.mini_time = tk.Label(inner, text="20:00", bg=CARD, fg=TEXT, font=f(22, True), anchor="w")
        self.mini_time.pack(fill="x")
        self.mini_bar = tk.Canvas(inner, height=S(6), bg=CARD, highlightthickness=0)
        self.mini_bar.pack(fill="x", pady=(S(6), 0))
        row = tk.Frame(bottom, bg=SIDE)
        row.pack(fill="x", pady=(S(14), 0))
        tk.Label(row, text="Track usage", bg=SIDE, fg=MUTED, font=f(10)).pack(side="left")
        Toggle(row, self.track_var, self.toggle_tracking).pack(side="right")
        row2 = tk.Frame(bottom, bg=SIDE)
        row2.pack(fill="x", pady=(S(10), 0))
        tk.Label(row2, text="Beep sound", bg=SIDE, fg=MUTED, font=f(10)).pack(side="left")
        Toggle(row2, self.beep_var).pack(side="right")

    def _build_topbar(self, main):
        bar_ = tk.Frame(main, bg=BG)
        bar_.grid(row=0, column=0, sticky="ew")
        left = tk.Frame(bar_, bg=BG)
        left.pack(side="left")
        self.title_lbl = tk.Label(left, text="", bg=BG, fg=TEXT, font=f(21, True), anchor="w")
        self.title_lbl.pack(anchor="w")
        self.sub_lbl = tk.Label(left, text="", bg=BG, fg=MUTED, font=f(10), anchor="w")
        self.sub_lbl.pack(anchor="w")
        right = tk.Frame(bar_, bg=BG)
        right.pack(side="right")
        ttk.Button(right, text="Export CSV", style="Ghost.TButton", command=self.export_csv).pack(side="right")
        self.combo = ttk.Combobox(right, textvariable=self.date_var, width=12, state="readonly")
        self.combo.pack(side="right", padx=S(10))
        self.combo.bind("<<ComboboxSelected>>", lambda e: self.refresh_now())
        tk.Label(right, text="Date", bg=BG, fg=MUTED, font=f(10)).pack(side="right")

    def _build_dashboard(self, p):
        p.columnconfigure(0, weight=1)
        p.rowconfigure(1, weight=3)
        p.rowconfigure(2, weight=3)
        k = tk.Frame(p, bg=BG)
        k.grid(row=0, column=0, sticky="ew")
        self.kpis = {}
        specs = [("screen", "Screen time", ACCENT, False), ("focus", "Focus score", GOOD, True),
                 ("rests", "Rests taken", ACCENT_HI, False), ("longest", "Longest session", WARN, False)]
        for i, (key, title, color, ring) in enumerate(specs):
            k.columnconfigure(i, weight=1, uniform="kpi")
            w = KPI(k, title, color, ring)
            w.grid(row=0, column=i, sticky="nsew", padx=(0 if i == 0 else S(7), 0 if i == 3 else S(7)))
            self.kpis[key] = w

        r1 = tk.Frame(p, bg=BG)
        r1.grid(row=1, column=0, sticky="nsew", pady=S(14))
        r1.rowconfigure(0, weight=1)
        r1.columnconfigure(0, weight=3, uniform="r1")
        r1.columnconfigure(1, weight=2, uniform="r1")
        c, body, self.hour_right = card(r1, "Activity by hour")
        c.grid(row=0, column=0, sticky="nsew", padx=(0, S(7)))
        self.hour_chart = BarChart(body, height=200)
        self.hour_chart.pack(fill="both", expand=True)
        c, body, self.apps_right = card(r1, "Top applications")
        c.grid(row=0, column=1, sticky="nsew", padx=(S(7), 0))
        self.donut = DonutChart(body, height=200)
        self.donut.pack(fill="both", expand=True)

        r2 = tk.Frame(p, bg=BG)
        r2.grid(row=2, column=0, sticky="nsew")
        r2.rowconfigure(0, weight=1)
        for i in range(3):
            r2.columnconfigure(i, weight=1, uniform="r2")
        c, body, self.week_right = card(r2, "Last 7 days")
        c.grid(row=0, column=0, sticky="nsew", padx=(0, S(7)))
        self.week_chart = BarChart(body, height=170)
        self.week_chart.pack(fill="both", expand=True)
        c, body, self.sites_right = card(r2, "Top websites")
        c.grid(row=0, column=1, sticky="nsew", padx=S(7))
        self.sites_list = HBarList(body, height=170)
        self.sites_list.empty_text = "No website data yet"
        self.sites_list.pack(fill="both", expand=True)
        c, body, _ = card(r2, "Time by category")
        c.grid(row=0, column=2, sticky="nsew", padx=(S(7), 0))
        self.cat_list = HBarList(body, height=170)
        self.cat_list.pack(fill="both", expand=True)

    def _build_timer(self, p):
        p.columnconfigure(0, weight=3, uniform="t")
        p.columnconfigure(1, weight=2, uniform="t")
        p.rowconfigure(0, weight=1)
        c, body, _ = card(p, "20-20 rest reminder")
        c.grid(row=0, column=0, sticky="nsew", padx=(0, S(7)))
        self.timer_caption = tk.Label(body, text="Next rest in", bg=CARD, fg=MUTED, font=f(11))
        self.timer_caption.pack(pady=(S(8), 0))
        self.timer_ring = Ring(body, size=300, thick=0.075, main_size=46, sub_size=11)
        self.timer_ring.pack(fill="both", expand=True, padx=S(20), pady=S(6))
        self.timer_status = tk.Label(body, text="Running", bg=CARD, fg=GOOD, font=f(11, True))
        self.timer_status.pack()
        btns = tk.Frame(body, bg=CARD)
        btns.pack(pady=S(16))
        self.pause_btn = ttk.Button(btns, text="Pause", style="Accent.TButton", command=self.toggle_pause)
        self.pause_btn.pack(side="left", padx=S(6))
        ttk.Button(btns, text="Rest now", style="Ghost.TButton", command=self.start_rest).pack(side="left", padx=S(6))
        ttk.Button(btns, text="Reset", style="Ghost.TButton", command=self.reset).pack(side="left", padx=S(6))

        col = tk.Frame(p, bg=BG)
        col.grid(row=0, column=1, sticky="nsew", padx=(S(7), 0))
        col.columnconfigure(0, weight=1)
        c, body, _ = card(col, "Settings")
        c.grid(row=0, column=0, sticky="ew")
        g = tk.Frame(body, bg=CARD)
        g.pack(fill="x", padx=S(10), pady=S(6))
        g.columnconfigure(0, weight=1)
        tk.Label(g, text="Remind me every (minutes)", bg=CARD, fg=TEXT, font=f(10)).grid(row=0, column=0, sticky="w", pady=S(7))
        ttk.Spinbox(g, from_=1, to=120, width=6, textvariable=self.interval_var, command=self.on_interval_change
                    ).grid(row=0, column=1)
        tk.Label(g, text="Rest for (seconds)", bg=CARD, fg=TEXT, font=f(10)).grid(row=1, column=0, sticky="w", pady=S(7))
        ttk.Spinbox(g, from_=5, to=600, width=6, textvariable=self.rest_var).grid(row=1, column=1)
        tk.Label(g, text="Track app & website usage", bg=CARD, fg=TEXT, font=f(10)).grid(row=2, column=0, sticky="w", pady=S(7))
        Toggle(g, self.track_var, self.toggle_tracking, bg=CARD).grid(row=2, column=1, sticky="e")
        tk.Label(g, text="Beep sound", bg=CARD, fg=TEXT, font=f(10)).grid(row=3, column=0, sticky="w", pady=S(7))
        Toggle(g, self.beep_var, bg=CARD).grid(row=3, column=1, sticky="e")

        c, body, _ = card(col, "Rest statistics")
        c.grid(row=1, column=0, sticky="ew", pady=(S(14), 0))
        g = tk.Frame(body, bg=CARD)
        g.pack(fill="x", padx=S(10), pady=S(6))
        g.columnconfigure((0, 1), weight=1, uniform="s")
        self.rest_stats = {}
        for i, (key, title) in enumerate((("today", "Rests today"), ("week", "Last 7 days"),
                                          ("avg", "Daily average"), ("next", "Next rest at"))):
            cell = tk.Frame(g, bg=CARD2)
            cell.grid(row=i // 2, column=i % 2, sticky="nsew", padx=S(4), pady=S(4))
            tk.Label(cell, text=title.upper(), bg=CARD2, fg=MUTED, font=f(8, True)).pack(anchor="w", padx=S(12), pady=(S(10), 0))
            lbl = tk.Label(cell, text="-", bg=CARD2, fg=TEXT, font=f(18, True))
            lbl.pack(anchor="w", padx=S(12), pady=(0, S(10)))
            self.rest_stats[key] = lbl

        tip = tk.Label(col, text="The 20-20-20 rule: every 20 minutes look at something 20 feet away for 20 seconds."
                       , bg=BG, fg=MUTED, font=f(9), wraplength=S(330), justify="left")
        tip.grid(row=2, column=0, sticky="w", pady=(S(14), 0))
        if auto is None:
            tk.Label(col, text="Tip: run  python -m pip install uiautomation  for exact website names.",
                     bg=BG, fg=WARN, font=f(9), wraplength=S(330), justify="left").grid(row=3, column=0, sticky="w", pady=(S(8), 0))

    # ------------------------------------------------------------- navigation
    def show(self, key):
        self.page = key
        self.pages[key].tkraise()
        for k, it in self.nav.items():
            it.set_active(k == key)
        titles = {"dashboard": "Dashboard", "apps": "Applications", "sites": "Websites", "timer": "Rest Timer"}
        self.title_lbl.config(text=titles[key])
        self.refresh_now()

    # ------------------------------------------------------------------ data
    def toggle_tracking(self):
        self.tracker.paused = not self.track_var.get()

    def on_interval_change(self):
        pass

    def refresh_loop(self):
        self.refresh_now()
        self.root.after(2000, self.refresh_loop)

    def refresh_now(self):
        today = datetime.date.today().isoformat()
        if today != self._today:                      # a new day started
            if self.date_var.get() == self._today:
                self.date_var.set(today)
            self._today = today
        dates = self.tracker.dates()
        if tuple(self.combo["values"]) != tuple(dates):
            self.combo["values"] = dates
        day = self.date_var.get()
        try:
            dd = datetime.date.fromisoformat(day)
            pretty = dd.strftime("%A, %d %B %Y") + ("  ·  Today" if day == today else "")
        except ValueError:
            pretty = day
        self.sub_lbl.config(text=pretty)
        snap = self.tracker.snapshot(day)
        if self.page == "dashboard":
            self.update_dashboard(day, snap)
        elif self.page == "apps":
            self.apps_page.refresh(snap)
        elif self.page == "sites":
            self.sites_page.refresh(snap)
        else:
            self.update_timer_stats(today)

    def update_dashboard(self, day, snap):
        total = snap["total"]
        series = self.tracker.series(day, 7)
        prev = series[-2][1] if len(series) > 1 else 0.0

        if total <= 0:
            self.kpis["screen"].set("0m", "No activity recorded")
        elif prev > 0:
            ch = (total - prev) / prev * 100
            arrow = "▲" if ch >= 0 else "▼"
            self.kpis["screen"].set(fmt_dur(total), f"{arrow} {abs(ch):.0f}% vs previous day",
                                    WARN if ch >= 0 else GOOD)
        else:
            self.kpis["screen"].set(fmt_dur(total), "No data for previous day")

        cats = category_totals(snap)
        score = int(round(cats["Work"] * 100 / total)) if total > 0 else 0
        if total <= 0:
            label, col = "No data yet", MUTED
        elif score >= 70:
            label, col = "Excellent focus", GOOD
        elif score >= 50:
            label, col = "Good focus", GOOD
        elif score >= 30:
            label, col = "Fair focus", WARN
        else:
            label, col = "Mostly leisure / other", BAD
        self.kpis["focus"].set(f"{score}%", label, col)
        self.kpis["focus"].ring.set(score / 100, "", "", col)

        try:
            iv = max(1, int(self.interval_var.get()))
        except tk.TclError:
            iv = DEFAULT_INTERVAL_MIN
        suggested = int(total // 60 // iv)
        self.kpis["rests"].set(str(snap["rests"]), f"of ~{suggested} suggested" if suggested else "Keep it up")
        self.kpis["longest"].set(fmt_dur(snap["longest"]) if snap["longest"] else "0m",
                                 "continuous activity")

        # hourly activity
        hours = snap["hours"]
        mins = [s / 60 for s in hours]
        peak = max(range(24), key=lambda h: hours[h]) if total > 0 else None
        tips = [f"{h:02d}:00 - {h:02d}:59\n{fmt_dur(hours[h])}" if hours[h] > 0 else "" for h in range(24)]
        self.hour_chart.set([f"{h:02d}" if h % 3 == 0 else "" for h in range(24)], mins, 60,
                            [(0, "0"), (15, "15m"), (30, "30m"), (45, "45m"), (60, "60m")], peak, tips)
        self.hour_right.config(text=f"Peak hour  {peak:02d}:00" if peak is not None else "")

        # apps donut
        apps = snap["apps"]
        items = [(n, s, PALETTE[i]) for i, (n, s) in enumerate(apps[:5])]
        rest = sum(s for _, s in apps[5:])
        if rest > 0:
            items.append((f"Others ({len(apps) - 5})", rest, "#64748b"))
        self.donut.set(items, fmt_dur(total), f"{len(apps)} apps")
        self.apps_right.config(text=f"{len(apps)} used")

        # last 7 days
        vals = [t / 3600 for _, t, _ in series]
        ymax = nice_max(max(vals), [1, 2, 3, 4, 6, 8, 10, 12, 16, 24])
        ticks = [(ymax * i / 4, f"{ymax * i / 4:g}h") for i in range(5)]
        labs = [datetime.date.fromisoformat(d).strftime("%a") for d, _, _ in series]
        wtips = [f"{datetime.date.fromisoformat(d).strftime('%d %b')}\n{fmt_dur(t)}" if t > 0 else ""
                 for d, t, _ in series]
        self.week_chart.set(labs, vals, ymax, ticks, len(vals) - 1, wtips)
        active = [t for _, t, _ in series if t > 0]
        self.week_right.config(text=f"Avg {fmt_dur(sum(active) / len(active))}" if active else "")

        # top websites
        agg = {}
        for lst in snap["sites"].values():
            for site, sec in lst:
                agg[site] = agg.get(site, 0.0) + sec
        top = sorted(agg.items(), key=lambda kv: kv[1], reverse=True)
        stotal = sum(agg.values())
        rows = [(s, f"{fmt_dur(v)}   {v * 100 / stotal:.0f}%", v / top[0][1], ACCENT_HI) for s, v in top[:6]]
        self.sites_list.set(rows)
        self.sites_right.config(text=f"{len(agg)} visited" if agg else "")

        # categories
        crow = [(c, f"{fmt_dur(cats[c])}   {cats[c] * 100 / total:.0f}%", cats[c] / total, CAT_COLORS[c])
                for c in CATEGORIES if cats[c] > 0] if total > 0 else []
        self.cat_list.set(crow)

    def update_timer_stats(self, today):
        ser = self.tracker.series(today, 7)
        week = sum(r for _, _, r in ser)
        active_days = [1 for _, t, _ in ser if t > 0]
        self.rest_stats["today"].config(text=str(ser[-1][2]))
        self.rest_stats["week"].config(text=str(week))
        self.rest_stats["avg"].config(text=f"{week / len(active_days):.1f}" if active_days else "0")
        if not self.paused:
            at = datetime.datetime.now() + datetime.timedelta(seconds=max(0, self.deadline - time.monotonic()))
            self.rest_stats["next"].config(text=at.strftime("%H:%M") if self.state == "work" else "Resting")
        else:
            self.rest_stats["next"].config(text="Paused")

    def export_csv(self):
        from tkinter import filedialog
        import csv
        day = self.date_var.get()
        path = filedialog.asksaveasfilename(defaultextension=".csv", initialfile=f"usage_{day}.csv",
                                            filetypes=[("CSV file", "*.csv")], title="Export usage")
        if not path:
            return
        snap = self.tracker.snapshot(day)
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as fh:
                w = csv.writer(fh)
                w.writerow(["Date", "Type", "Application / Browser", "Website", "Seconds", "Time"])
                for app_, sec in snap["apps"]:
                    w.writerow([day, "App", app_, "", int(sec), fmt_hms(sec)])
                for browser, lst in snap["sites"].items():
                    for site, sec in lst:
                        w.writerow([day, "Website", browser, site, int(sec), fmt_hms(sec)])
        except OSError:
            pass

    def on_close(self):
        self.tracker.stop()
        self.tracker.save()
        self.root.destroy()

    # ------------------------------------------------------------- timer logic
    def interval_sec(self) -> float:
        try:
            return max(1, int(self.interval_var.get())) * 60
        except (tk.TclError, ValueError):
            return DEFAULT_INTERVAL_MIN * 60

    def rest_sec(self) -> float:
        try:
            return max(5, int(self.rest_var.get()))
        except (tk.TclError, ValueError):
            return DEFAULT_REST_SEC

    @staticmethod
    def fmt(seconds: float) -> str:
        seconds = max(0, int(seconds + 0.999))
        return f"{seconds // 60:02d}:{seconds % 60:02d}"

    def _begin(self, state: str, seconds: float):
        self.state = state
        self.paused = False
        self.phase_total = max(1.0, float(seconds))
        self.deadline = time.monotonic() + seconds
        self.pause_btn.config(text="Pause")
        self.timer_caption.config(text="Next rest in" if state == "work" else "Rest time left")
        self.mini_caption.config(text="NEXT REST IN" if state == "work" else "RESTING")
        self.timer_status.config(text="Running" if state == "work" else "Resting", fg=GOOD if state == "work" else ACCENT_HI)

    def reset(self):
        self.close_break_window()
        self._begin("work", self.interval_sec())

    def toggle_pause(self):
        if not self.paused:
            self.paused = True
            self.paused_remaining = self.deadline - time.monotonic()
            self.pause_btn.config(text="Resume")
            self.timer_status.config(text="Paused", fg=WARN)
        else:
            self.paused = False
            self.deadline = time.monotonic() + self.paused_remaining
            self.pause_btn.config(text="Pause")
            self.timer_status.config(text="Running" if self.state == "work" else "Resting",
                                     fg=GOOD if self.state == "work" else ACCENT_HI)

    def start_rest(self):
        if self.state == "rest":
            return
        self._begin("rest", self.rest_sec())
        toast("Time to rest your eyes", f"Look away from the screen for {int(self.rest_sec())} seconds.")
        if self.beep_var.get():
            short_beep()
        self.open_break_window()

    def end_rest(self):
        self.close_break_window()
        self.tracker.add_rest()
        toast("Rest over", "Great! You can get back to work now.")
        if self.beep_var.get():
            play_alarm()
        self._begin("work", self.interval_sec())
        self.root.deiconify()
        self.root.lift()

    def open_break_window(self):
        self.close_break_window()
        w = tk.Toplevel(self.root)
        w.title("Take a rest")
        w.attributes("-topmost", True)
        w.configure(bg=CARD)
        sw, sh = w.winfo_screenwidth(), w.winfo_screenheight()
        ww, wh = S(480), S(470)
        w.geometry(f"{ww}x{wh}+{(sw - ww) // 2}+{(sh - wh) // 2}")
        w.resizable(False, False)
        w.protocol("WM_DELETE_WINDOW", lambda: None)
        tk.Label(w, text="Rest your eyes", font=f(22, True), fg=TEXT, bg=CARD).pack(pady=(S(26), 0))
        tk.Label(w, text="Look at something 20 feet away", font=f(11), fg=MUTED, bg=CARD).pack(pady=(S(4), 0))
        self.break_ring = Ring(w, size=260, thick=0.08, main_size=44, sub_size=10)
        self.break_ring.pack(fill="both", expand=True, padx=S(30), pady=S(18))
        self.break_win = w

    def close_break_window(self):
        if self.break_win is not None:
            try:
                self.break_win.destroy()
            except tk.TclError:
                pass
            self.break_win = None
            self.break_ring = None

    def tick(self):
        if not self.paused:
            remaining = self.deadline - time.monotonic()
            frac = max(0.0, min(1.0, remaining / self.phase_total))
            color = ACCENT if self.state == "work" else ACCENT_HI
            txt = self.fmt(remaining)
            self.timer_ring.set(frac, txt, f"of {self.fmt(self.phase_total)}", color)
            self.mini_time.config(text=txt)
            self.mini_bar.delete("all")
            w = self.mini_bar.winfo_width()
            hh = self.mini_bar.winfo_height()
            if w > 4:
                rrect(self.mini_bar, 0, 0, w, hh, hh / 2, fill=CARD2, outline="")
                if frac > 0:
                    rrect(self.mini_bar, 0, 0, max(hh, w * frac), hh, hh / 2, fill=color, outline="")
            if self.break_ring is not None:
                self.break_ring.set(frac, txt, "seconds left" if remaining < 60 else "", ACCENT_HI)
            if remaining <= 0:
                if self.state == "work":
                    self.start_rest()
                else:
                    self.end_rest()
        self.root.after(200, self.tick)


if __name__ == "__main__":
    if os.name == "nt":
        try:                                    # sharp text on high-DPI screens
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except Exception:
            pass
    tracker = UsageTracker()
    tracker.start()
    root = tk.Tk()
    App(root, tracker)
    root.mainloop()
